# Copy to config/windows.env and edit.
# Absolute paths recommended (no trailing slashes). Avoid spaces if possible.
SONIC_ANNOTATOR_EXE=C:\AudioTools\sonic-annotator\sonic-annotator.exe
VAMP_PATH=C:\AudioTools\vamp
OPENSMILE_EXE=C:\AudioTools\openSMILE\SMILExtract.exe

# openSMILE config (optional). eGeMAPS is a good default
OPENSMILE_CONFIG=C:\AudioTools\openSMILE\config\gemaps\eGeMAPSv02.conf

# Demucs stem separation configuration
DEMUCS_CMD=.venv\Scripts\demucs.exe
DEMUCS_ARGS=-n htdemucs --segment 7 --overlap 0.1 --jobs 1 --shifts 1 --two-stems vocals
DEMUCS_DEVICE=cuda
DEMUCS_OUTDIR=C:\demucs\stems
FFMPEG_PATH=C:\Users\username\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-8.0-full_build\bin

# MAEST auto-tagging
MAEST_PYTHON_PATH=.venv\maest\Scripts\python.exe
MAEST_CLI_PATH=tools\maest\maest_cli.py
MAEST_TOP_K=7
EMBEDDINGS_PATH=training/embeddings

# API secrets for database storage and gpt-5-mini for genre-explainer.js
DATABASE_URI=
OPENAI_API_KEY=

