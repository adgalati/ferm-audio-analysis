{
  "name": "ferm-audio-analysis",
  "version": "1.4.4",
  "private": true,
  "type": "module",
  "description": "Windows-native Electron + React desktop app for comprehensive audio analysis, featuring stem separation (Demucs), genre classification (MAEST), and musicality scoring. Powered by Vamp plugins, FFmpeg, and openSMILE.",
  "author": {
    "name": "Anthony Galati (FERM)",
    "email": "ferm@realferm.com",
    "url": "https://github.com/adgalati/ferm-audio-analysis"
  },
  "main": "electron/main.js",
  "bin": {
    "ferm-vamp": "./bin/ferm-vamp.js"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "build:electron": "npm run build && electron-builder",
    "analyze": "node src/analyze.js",
    "test": "node --test"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "chart.js": "^4.4.1",
    "chokidar": "^4.0.3",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.6.0",
    "date-fns": "^4.1.0",
    "essentia.js": "^0.1.3",
    "execa": "^9.3.0",
    "fast-glob": "^3.3.2",
    "lucide-react": "^0.344.0",
    "mongodb": "^6.7.0",
    "onnxruntime-node": "^1.23.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "wavesurfer.js": "^7.7.3",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@headlessui/react": "^1.7.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "baseline-browser-mapping": "^2.9.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "html2canvas": "^1.4.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.ferm.audio-analysis",
    "productName": "FERM Audio Analysis",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/**/*",
      "scripts/**/*",
      "config/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "models/**/*",
      "lib/**/*",
      "scripts/**/*"
    ],
    "extraResources": [
      {
        "from": "docs/iZotope Target Curves",
        "to": "izotope-target-curves",
        "filter": [
          "*.json"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}